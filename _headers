# Cloudflare Pages headers

# Farcaster manifest - CORS enabled, short cache
/.well-known/farcaster.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300, must-revalidate

# Data files - short cache for freshness
/data/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=30, must-revalidate

# Static assets - long cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/screens/*
  Cache-Control: public, max-age=31536000, immutable

# Content-hashed vendor bundles (js/vendor/privy-sdk-<ver>.<hash>.js) and fonts - immutable
/js/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=604800

/manifest.json
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

# JS/CSS - medium cache (index.html pins ?v=prNN on every file)
/js/*
  Cache-Control: public, max-age=3600, must-revalidate

/css/*
  Cache-Control: public, max-age=3600, must-revalidate
